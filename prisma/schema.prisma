// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  color String?
  tasks TaskTag[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    Int       @default(3) // 1(높음) ~ 4(낮음)
  completed   Boolean   @default(false)
  completedAt DateTime?
  recurrence  String? // "DAILY" | "WEEKLY" | "MONTHLY" 등
  order       Int       @default(0)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  tags TaskTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 목록 4개 뷰(전체/오늘/예정/완료)가 전부 "parentId IS NULL + completed" 로 시작하고
  // 그다음 dueDate 로 정렬하므로 이 순서의 복합 인덱스 하나로 모두 커버된다.
  @@index([parentId, completed, dueDate])
  // 부모별 서브태스크 로딩(include: subtasks)과 프로젝트 필터/자동정리 카운트용
  @@index([parentId])
  @@index([projectId])
  // 주간보고의 완료 기간 조회용
  @@index([completed, completedAt])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  // 복합 PK의 선두 컬럼이 taskId 라서 tagId 단독 조회(태그 자동정리 카운트, 태그별 칸반)는
  // 인덱스를 못 타고 전체 스캔이 된다. 그래서 tagId 인덱스를 따로 둔다.
  @@index([tagId])
}

model PriorityColor {
  priority Int    @id // 1~4
  color    String
}
