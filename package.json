{
  "name": "mytodo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start -p 3333",
    "serve": "next build && next start -p 3333",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/hooks.mjs --test \"tests/unit/**/*.test.ts\" \"tests/actions/**/*.test.ts\"",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/hooks.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:routes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/hooks.mjs --test \"tests/routes/**/*.test.ts\"",
    "test:all": "npm run test && npm run build && npm run test:routes"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "next": "16.3.4",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
